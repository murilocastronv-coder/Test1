{
  // Worker config (CF-standard). Used by `wrangler dev` for local testing.
  // The DEPLOYED script name is set by the platform (= project slug) — this "name"
  // only matters for local dev. DO bindings + migrations below are the source of
  // truth that build emits to dist/cf-metadata.json for the platform deploy.
  "name": "game-worker",
  "main": "src/index.ts",
  "compatibility_date": "2026-05-01",
  // Frontend (the Vite build) is served by this same worker as Workers Static Assets.
  // Non-asset paths fall through to the worker's fetch (/api, /map). `../website/out`
  // is the existing build output (relative to worker/, for local `wrangler dev`).
  "assets": { "directory": "../website/out", "binding": "ASSETS" },
  "durable_objects": {
    "bindings": [{ "name": "MAP", "class_name": "GameMap" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["GameMap"] }]
}
